// Database schema — using Postgres, which is what Render (and most real
// hosting) provides. If you also want to develop locally against this same
// database, point DATABASE_URL in your .env at the same Render Postgres
// connection string — no separate local database needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: fields like `role`, `verificationStatus`, `condition`, and `status`
// are plain Strings rather than native Prisma enums — this keeps the schema
// portable between SQLite (used earlier in local dev) and Postgres without
// changing anything else. Allowed values are enforced in the route handlers
// (see src/routes/*.js).

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  phone              String?
  passwordHash       String
  department         String?
  faculty            String?
  matricNumber       String?            @unique
  studentPortalScreenshotUrl  String?         // screenshot of the student's logged-in AKSU portal dashboard — admin cross-checks name/matric number against this instead of an ID card photo (AKSU has no public verification API)
  role               String             @default("STUDENT")
  verificationStatus String             @default("UNVERIFIED") // drives "AKSU Verified" badge: VERIFIED = badge shown
  phoneVerified      Boolean            @default(false)         // "Phone Verified" badge — set by Phase 2's real OTP flow, or manually by admin as a fallback
  phoneOtpCode       String?                                     // hashed OTP (bcrypt), never plaintext
  phoneOtpExpiresAt  DateTime?
  phoneOtpAttempts   Int                @default(0)              // rate-limit guard
  identityVerified   Boolean            @default(false)         // "Identity Verified" badge — manually toggled by admin (stronger check than matric+portal screenshot alone)
  paystackSubaccountCode String?                                 // set once a seller completes Paystack subaccount onboarding (Phase 3)
  avatarUrl          String?
  bio                String?
  rating             Float              @default(0)
  ratingCount        Int                @default(0)
  resetToken         String?
  resetTokenExpires  DateTime?
  deletedAt          DateTime? // self-service account deletion — personal fields get anonymized, row stays for referential integrity (messages, reviews, transactions)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  listings      Listing[]
  sentMessages  Message[] @relation("SentMessages")
  recvMessages  Message[] @relation("ReceivedMessages")
  reportsFiled  Report[]  @relation("ReportsFiled")
  reviewsGiven  Review[]  @relation("ReviewsGiven")
  reviewsGot    Review[]  @relation("ReviewsReceived")
  disputesFiled Dispute[] @relation("DisputesFiled")
  disputesAgainst Dispute[] @relation("DisputesAgainst")
  deviceFingerprints DeviceFingerprint[]
  riskFlags     RiskFlag[]
  buyerTransactions  Transaction[] @relation("BuyerTransactions")
  sellerTransactions Transaction[] @relation("SellerTransactions")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  icon     String?
  listings Listing[]
}

model Listing {
  id          String            @id @default(uuid())
  title       String
  description String
  price       Float
  condition   String            @default("GOOD")
  location    String
  status      String            @default("ACTIVE")
  featured    Boolean           @default(false)
  itemVerified Boolean          @default(false) // "Item Inspected" badge — SEPARATE from seller verification (a verified student != a verified item). Admin sets this after a real physical check, per item.
  boostedUntil DateTime?        // paid promotion (self-serve) — treated the same as `featured` (admin-curated) for surfacing purposes, but expires on its own
  viewCount   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  seller      User      @relation(fields: [sellerId], references: [id])
  sellerId    String
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String

  images      ListingImage[]
  messages    Message[]
  reports     Report[]
  reviews     Review[]
  disputes    Dispute[]
  riskFlags   RiskFlag[]
  transactions Transaction[]
  boosts      ListingBoost[]
}

model ListingImage {
  id        String   @id @default(uuid())
  url       String
  perceptualHash String? // for duplicate/stolen photo detection (Phase 2)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  flaggedAsOriginal DuplicateImageFlag[] @relation("OriginalImage")
  flaggedAsSuspect  DuplicateImageFlag[] @relation("SuspectImage")

  @@index([perceptualHash])
}

model Message {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  readAt     DateTime?

  listing    Listing  @relation(fields: [listingId], references: [id])
  listingId  String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String
}

model Report {
  id        String   @id @default(uuid())
  reason    String
  details   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  reporter  User     @relation("ReportsFiled", fields: [reporterId], references: [id])
  reporterId String
}

model Review {
  id            String   @id @default(uuid())
  itemMatched   Boolean
  communication Int
  experience    Int
  comment       String?
  createdAt     DateTime @default(now())

  listing       Listing  @relation(fields: [listingId], references: [id])
  listingId     String
  reviewer      User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewerId    String
  seller        User     @relation("ReviewsReceived", fields: [sellerId], references: [id])
  sellerId      String
}

// A dispute is a specific, this-transaction-went-wrong complaint (e.g. "the
// phone I got isn't the one in the listing photos") — distinct from a Report,
// which flags a listing in general (scam, prohibited item, etc.) without
// necessarily having transacted. Disputes are reviewed by an admin, who sees
// the full context: the listing, the message thread, and both accounts.
model Dispute {
  id        String   @id @default(uuid())
  reason    String
  details   String?
  status    String   @default("OPEN") // "OPEN" | "RESOLVED" | "REJECTED"
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  buyer     User     @relation("DisputesFiled", fields: [buyerId], references: [id])
  buyerId   String
  seller    User     @relation("DisputesAgainst", fields: [sellerId], references: [id])
  sellerId  String

  transaction Transaction? // set if this dispute originated from a paid Transaction (Phase 3)
}

// ============================================================
// PHASE 2: fraud-signal features
// ============================================================

// One row per (device, user) pairing seen. A device fingerprint shared
// across multiple DISTINCT users is a signal of possible multi-accounting.
model DeviceFingerprint {
  id          String   @id @default(uuid())
  fingerprint String   // hashed client-side device signal, never raw
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
  ipHash      String?  // hashed, not raw IP — data minimization

  @@index([fingerprint])
  @@unique([fingerprint, userId])
}

// Records a likely duplicate/stolen photo match between two listing images.
model DuplicateImageFlag {
  id              String       @id @default(uuid())
  originalImage   ListingImage @relation("OriginalImage", fields: [originalImageId], references: [id])
  originalImageId String
  suspectImage    ListingImage @relation("SuspectImage", fields: [suspectImageId], references: [id])
  suspectImageId  String
  hammingDistance Int          // similarity score, lower = more similar
  reviewed        Boolean      @default(false)
  createdAt       DateTime     @default(now())
}

// Automated fraud-signal flags (multi-account devices, duplicate photos),
// separate from admin-reviewed Reports/Disputes filed by users. Feeds into
// the admin risk level shown in the Admin dashboard (see src/utils/trust.js).
model RiskFlag {
  id        String   @id @default(uuid())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  listingId String?
  type      String   // "MULTI_ACCOUNT_DEVICE" | "DUPLICATE_PHOTO"
  severity  String   // "YELLOW" | "RED"
  details   String   // human-readable, admin-only
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============================================================
// PHASE 3: escrow-style payments (Paystack)
// ============================================================

model Transaction {
  id        String  @id @default(uuid())
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  buyer     User    @relation("BuyerTransactions", fields: [buyerId], references: [id])
  buyerId   String
  seller    User    @relation("SellerTransactions", fields: [sellerId], references: [id])
  sellerId  String

  itemAmount   Int // kobo, not naira — avoids float rounding on money
  platformFee  Int // kobo
  totalAmount  Int // kobo, itemAmount + platformFee

  status String @default("PENDING")
  // PENDING -> HELD -> RELEASED
  //         -> DISPUTED -> REFUNDED | RELEASED (after admin resolution)

  providerReference  String? @unique // Paystack transaction reference
  providerSubaccount String?         // seller's Paystack subaccount code, if payment was auto-split

  dispute   Dispute? @relation(fields: [disputeId], references: [id])
  disputeId String?  @unique

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  releasedAt  DateTime?
  refundedAt  DateTime?
}

// Raw webhook log for auditing/replay/debugging. Never trust webhook data
// without verifying its signature first (see src/services/paystack.js).
model PaymentWebhookEvent {
  id          String    @id @default(uuid())
  provider    String    // "PAYSTACK"
  eventType   String
  rawPayload  String    // JSON string, for audit trail
  signatureOk Boolean
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

// Paid, self-serve listing promotion — separate from admin-curated
// `featured`. This is platform revenue, so it's a straight payment (no
// subaccount split with the seller, unlike item-purchase Transactions).
model ListingBoost {
  id                String   @id @default(uuid())
  listing           Listing  @relation(fields: [listingId], references: [id])
  listingId         String
  sellerId          String
  amountKobo        Int
  durationDays      Int
  status            String   @default("PENDING") // PENDING -> ACTIVE (paid) — no further states needed, it just expires on its own
  providerReference String   @unique
  createdAt         DateTime @default(now())
}
