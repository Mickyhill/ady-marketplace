// Database schema — using Postgres, which is what Render (and most real
// hosting) provides. If you also want to develop locally against this same
// database, point DATABASE_URL in your .env at the same Render Postgres
// connection string — no separate local database needed.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NOTE: fields like `role`, `verificationStatus`, `condition`, and `status`
// are plain Strings rather than native Prisma enums — this keeps the schema
// portable between SQLite (used earlier in local dev) and Postgres without
// changing anything else. Allowed values are enforced in the route handlers
// (see src/routes/*.js).

model User {
  id                 String             @id @default(uuid())
  name               String
  email              String             @unique
  phone              String?
  passwordHash       String
  department         String?
  faculty            String?
  matricNumber       String?            @unique
  studentIdPhotoUrl  String?
  role               String             @default("STUDENT")
  verificationStatus String             @default("UNVERIFIED") // drives "AKSU Verified" badge: VERIFIED = badge shown
  phoneVerified      Boolean            @default(false)         // "Phone Verified" badge — manually toggled by admin until Phase 2 wires up real OTP
  identityVerified   Boolean            @default(false)         // "Identity Verified" badge — manually toggled by admin (stronger check than matric+ID photo alone)
  avatarUrl          String?
  bio                String?
  rating             Float              @default(0)
  ratingCount        Int                @default(0)
  resetToken         String?
  resetTokenExpires  DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  listings      Listing[]
  sentMessages  Message[] @relation("SentMessages")
  recvMessages  Message[] @relation("ReceivedMessages")
  reportsFiled  Report[]  @relation("ReportsFiled")
  reviewsGiven  Review[]  @relation("ReviewsGiven")
  reviewsGot    Review[]  @relation("ReviewsReceived")
  disputesFiled Dispute[] @relation("DisputesFiled")
  disputesAgainst Dispute[] @relation("DisputesAgainst")
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  icon     String?
  listings Listing[]
}

model Listing {
  id          String            @id @default(uuid())
  title       String
  description String
  price       Float
  condition   String            @default("GOOD")
  location    String
  status      String            @default("ACTIVE")
  featured    Boolean           @default(false)
  itemVerified Boolean          @default(false) // "Item Inspected" badge — SEPARATE from seller verification (a verified student != a verified item). Admin sets this after a real physical check, per item.
  viewCount   Int               @default(0)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  seller      User      @relation(fields: [sellerId], references: [id])
  sellerId    String
  category    Category  @relation(fields: [categoryId], references: [id])
  categoryId  String

  images      ListingImage[]
  messages    Message[]
  reports     Report[]
  reviews     Review[]
  disputes    Dispute[]
}

model ListingImage {
  id        String   @id @default(uuid())
  url       String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
}

model Message {
  id         String   @id @default(uuid())
  content    String
  createdAt  DateTime @default(now())
  readAt     DateTime?

  listing    Listing  @relation(fields: [listingId], references: [id])
  listingId  String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  senderId   String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  receiverId String
}

model Report {
  id        String   @id @default(uuid())
  reason    String
  details   String?
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  reporter  User     @relation("ReportsFiled", fields: [reporterId], references: [id])
  reporterId String
}

model Review {
  id            String   @id @default(uuid())
  itemMatched   Boolean
  communication Int
  experience    Int
  comment       String?
  createdAt     DateTime @default(now())

  listing       Listing  @relation(fields: [listingId], references: [id])
  listingId     String
  reviewer      User     @relation("ReviewsGiven", fields: [reviewerId], references: [id])
  reviewerId    String
  seller        User     @relation("ReviewsReceived", fields: [sellerId], references: [id])
  sellerId      String
}

// A dispute is a specific, this-transaction-went-wrong complaint (e.g. "the
// phone I got isn't the one in the listing photos") — distinct from a Report,
// which flags a listing in general (scam, prohibited item, etc.) without
// necessarily having transacted. Disputes are reviewed by an admin, who sees
// the full context: the listing, the message thread, and both accounts.
model Dispute {
  id        String   @id @default(uuid())
  reason    String
  details   String?
  status    String   @default("OPEN") // "OPEN" | "RESOLVED" | "REJECTED"
  createdAt DateTime @default(now())

  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  buyer     User     @relation("DisputesFiled", fields: [buyerId], references: [id])
  buyerId   String
  seller    User     @relation("DisputesAgainst", fields: [sellerId], references: [id])
  sellerId  String
}
