# Copy this file to .env and fill in real values before running the server.

DATABASE_URL="postgresql://user:password@host:5432/ady_marketplace"

JWT_SECRET="replace-this-with-a-long-random-string"
PORT=4000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"

# --- Phase 2: SMS/OTP for phone verification ---
# Leave these blank to run in DEV MODE — the OTP code gets logged to the
# server console instead of texted, so you can test the whole flow before
# signing up for a real SMS provider.
SMS_PROVIDER=                # "termii" or "africastalking"
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_USERNAME=        # Africa's Talking only
SMS_SENDER_ID=ADYMarket

# --- Phase 3: Paystack (escrow-style payments) ---
# Free test keys from paystack.com — no business verification needed for
# test mode. Payment/webhook routes throw a clear error if these are unset;
# they never silently fail or charge anyone without them.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PLATFORM_FEE_PERCENT=5        # your cut, as a percentage of the item price
BOOST_PRICE_PER_DAY_KOBO=10000 # ₦100/day default price for paid listing promotion

# --- Cloudinary (image storage) ---
# Required — without these, any photo upload (listings, avatars, student ID
# cards) will fail outright rather than silently falling back to local disk.
# Local disk storage was removed on purpose: Render's free tier wipes it on
# every redeploy, which is what deleted your earlier listing photos.
# Get these three from your Cloudinary dashboard after signing up free at
# cloudinary.com — they're shown right on the dashboard homepage.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
