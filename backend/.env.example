# Copy this file to .env and fill in real values before running the server.

# SQLite (zero setup, good for local dev):
DATABASE_URL="file:./dev.db"

# For production, use Postgres instead, e.g.:
# DATABASE_URL="postgresql://user:password@host:5432/aksmarketplace"
# ...and change the provider in prisma/schema.prisma from "sqlite" to "postgresql".

JWT_SECRET="replace-this-with-a-long-random-string"
PORT=4000
FRONTEND_URL="http://localhost:5173"
NODE_ENV="development"
